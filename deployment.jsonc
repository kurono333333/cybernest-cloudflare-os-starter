{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "d6726a38b563a01c6339a20854852086",
  "authenticationMode": "cybernest",
  "publicBaseUrl": "https://dev.dennoba.net",

  // Worker names are permanent service identities. Keep them unique within the account.
  // The Router owns the one public route; all other Workers stay private.
  "workers": {
    "router": {
      "name": "dev-dennoba-router",
      "route": { "customDomain": "dev.dennoba.net" }
    },
    "workshop": {
      "name": "dev-dennoba-os",

      // Preserved legacy field: current validateConfig accepts and ignores it.
      "route": null
    },
    "context": { "name": "dev-dennoba-context" },
    "scheduler": { "name": "dev-dennoba-scheduler" },
    "websearch": { "name": "dev-dennoba-websearch" },
    "customGatekeeper": { "name": "dev-dennoba-custom-gatekeeper" },
    "errorReporter": { "name": "dev-dennoba-error-reporter" }
  },

  // Keep the private Worker installed, but with no Router or Workshop path to invoke search.
  "webSearch": { "enabled": false },

  // Optional platform-funded model catalog. AI stays disabled.
  "aiGateway": {
    "enabled": false,
    "name": "default",
    "accountId": "d6726a38b563a01c6339a20854852086",
    "providers": ["cloudflare"]
  },

  "context": {
    // Preserve the existing Context data-isolation label and KV namespace.
    "sharingDomain": "dev",
    "kvNamespaceId": "569dbfde72de46deaa3cf590e0956a19"
  },

  // Preserve the existing custom integration configuration.
  "customGatekeeper": {
    "name": "Cybernest",
    "message": "Cybernest Manager context"
  },

  // Error Reporter stays disabled.
  "errorReporting": {
    "enabled": false,
    "environment": "dev",
    "release": null
  },

  // Preserve the existing KV namespaces and R2 bucket.
  "resources": {
    "blueprintsKvNamespaceId": "630728db6242410f896ba9bc768dcbfe",
    "avatarsKvNamespaceId": "96787d4ed2bc4383a307ba06172a699c",
    "blueprintContentBucket": "dev-dennoba-os-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
